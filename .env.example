APP_NAME=ApartmentAgent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://apartment:apartment@db:5432/apartment
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_NOTIFY_MIN_SCORE=85
CHECK_INTERVAL_MINUTES=120
SEARCH_ENABLED=true
SEARCH_INTERVAL_MINUTES=15
SEARCH_QUERIES_PER_RUN=8
SEARCH_PROVIDERS=krisha_direct,brave,bing_rss
BRAVE_SEARCH_API_KEY=
SEARCH_FRESHNESS=pw
KRISHA_SEARCH_PAGES=3
KRISHA_SEARCH_TIMEOUT_SECONDS=20
KRISHA_SEARCH_DELAY_SECONDS=2
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_DELAY_SECONDS=1.5
TWOGIS_ENABLED=true
TWOGIS_API_KEY=
