TWOGIS_TIMEOUT_SECONDS=10
TWOGIS_REFRESH_HOURS=24
AI_ENABLED=true
AI_REMOTE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
